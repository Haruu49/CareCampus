# Supabase project settings. Copy to .env.local and fill in the key.
# Both values are public: they are shipped to the browser. Row Level Security,
# not secrecy, is what protects the data.
#
# Find them in the dashboard under Connect, or Project Settings > API keys.
# Never put a service_role or secret key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
